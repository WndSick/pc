#include <stdio.h>
#include <mpi.h>

int main(int argc, char *argv[])
{
    int rank, data_send, data_recv;

    // ==================================================
    // SECTION 1: INITIALIZE MPI
    // ==================================================

    MPI_Init(&argc, &argv);

    MPI_Comm_rank(MPI_COMM_WORLD, &rank);

    // Each process sends its own rank
    data_send = rank;

    // ==================================================
    // SECTION 2: PROCESS 0
    // ==================================================

    if (rank == 0)
    {
        // Send 0 to Process 1
        MPI_Send(&data_send, 1, MPI_INT, 1, 0,
                 MPI_COMM_WORLD);

        // Receive 1 from Process 1
        MPI_Recv(&data_recv, 1, MPI_INT, 1, 0,
                 MPI_COMM_WORLD, MPI_STATUS_IGNORE);
    }

    // ==================================================
    // SECTION 3: PROCESS 1
    // ==================================================

    else if (rank == 1)
    {
        // Send 1 to Process 0
        MPI_Send(&data_send, 1, MPI_INT, 0, 0,
                 MPI_COMM_WORLD);

        // Receive 0 from Process 0
        MPI_Recv(&data_recv, 1, MPI_INT, 0, 0,
                 MPI_COMM_WORLD, MPI_STATUS_IGNORE);
    }

    // ==================================================
    // SECTION 4: DISPLAY RESULT
    // ==================================================

    printf("Process %d received %d\n", rank, data_recv);

    // ==================================================
    // SECTION 5: FINALIZE MPI
    // ==================================================

    MPI_Finalize();

    return 0;
}

